# Скопируйте в .env и укажите адрес бэкенда.
# Удалённый сервер: https://api.onthewater.ru или http://94.241.175.236 (без порта, Nginx на 80)
# Локально: http://localhost:3000 | эмулятор Android: http://10.0.2.2:3000 | телефон в той же сети: http://192.168.x.x:3000
#
# Важно: для release APK URL подставляется при сборке. После изменения пересоберите: npm run apk
EXPO_PUBLIC_API_URL=https://api.onthewater.ru
# или EXPO_PUBLIC_API_URL=http://94.241.175.236

# Яндекс AppMetrica (SDK): отдельные приложения в кабинете AppMetrica для клиента и владельца.
# Не Expo Go — только dev build / release. Ключи подставляются при prebuild (перезапустите Metro после правки .env).
# Клиент (EXPO_PUBLIC_APP_VARIANT=client или по умолчанию):
# EXPO_PUBLIC_APPMETRICA_API_KEY=
# Владелец (EXPO_PUBLIC_APP_VARIANT=owner — обязательно при сборке owner):
# EXPO_PUBLIC_APPMETRICA_API_KEY_OWNER=
